{
  "name": "dsh-pixel-wallpaper",
  "version": "0.1.0-alpha.1",
  "description": "像素背景：在 DSH Web 整窗底层铺一层算法实时生成的灰白像素格背景。",
  "license": "MIT",
  "author": "johnshere",
  "main": "src/index.js",
  "type": "commonjs",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client/bundle.js",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/johnshere/pixel-wallpaper.git"
  },
  "homepage": "https://github.com/johnshere/pixel-wallpaper#readme",
  "bugs": {
    "url": "https://github.com/johnshere/pixel-wallpaper/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "wallpaper",
    "canvas",
    "pixel"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "engines": {
    "node": ">=22.5",
    "dsh": ">=0.2.2-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "src/index.js",
    "src/config.js",
    "src/algorithm-schemas.js",
    "client/bundle.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs --assets",
    "check": "node --check src/index.js && node --check client/bundle.js",
    "test": "node --test \"test/*.test.mjs\""
  }
}
